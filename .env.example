# Development only. Copy to .env and replace the password.
POSTGRES_DB=thogamura
POSTGRES_USER=thogamura
POSTGRES_PASSWORD=change-this-local-password

# Network server database connection.
THOGAMURA_DB_URL=jdbc:postgresql://localhost:5432/thogamura
THOGAMURA_DB_USER=thogamura
THOGAMURA_DB_PASSWORD=change-this-local-password

# Browser -> Spring Boot gateway (safe public address, no secrets).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Planned branch gateway -> central warehouse network server (configured DNS/IP).
THOGAMURA_SERVER_HOST=localhost
THOGAMURA_COMMAND_PORT=7443
THOGAMURA_NIO_PORT=7444
# Planned central Java M2 read-only supplier HTTP connector; local demo mock only.
THOGAMURA_SUPPLIER_BASE_URL=http://127.0.0.1:8090
