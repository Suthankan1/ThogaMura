# Development only. Copy to .env and replace the password.
POSTGRES_DB=thogamura
POSTGRES_USER=thogamura
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Network server database connection.
THOGAMURA_DB_URL=jdbc:postgresql://localhost:5432/thogamura
THOGAMURA_DB_USER=thogamura
THOGAMURA_DB_PASSWORD=change-this-local-password

# Browser -> Spring Boot gateway (safe public address, no secrets).
GATEWAY_URL=http://127.0.0.1:8080

# Planned branch gateway -> central warehouse network server (configured DNS/IP).
THOGAMURA_WAREHOUSE_HOST=127.0.0.1
THOGAMURA_COMMAND_PORT=7443
THOGAMURA_NOTIFICATIONS_PORT=7444
# Planned central Java M2 read-only supplier HTTP connector; local demo mock only.
THOGAMURA_SUPPLIER_BASE_URL=http://127.0.0.1:8090

# Local loopback mode. For a TLS demo, set true and generate matching stores outside Git.
THOGAMURA_TLS_ENABLED=false
# Server keystore (configured on central warehouse network-server):
THOGAMURA_TLS_KEYSTORE_PATH=.certs/server-keystore.p12
THOGAMURA_TLS_KEYSTORE_PASSWORD=change-this-keystore-password
THOGAMURA_TLS_KEYSTORE_TYPE=PKCS12

# Gateway truststore (configured on branch API gateway):
THOGAMURA_TLS_TRUSTSTORE_PATH=.certs/gateway-truststore.p12
THOGAMURA_TLS_TRUSTSTORE_PASSWORD=change-this-truststore-password
THOGAMURA_TLS_TRUSTSTORE_TYPE=PKCS12
THOGAMURA_TLS_HOSTNAME_VERIFICATION=true

# Optional authenticated branch workspace. Enable on the warehouse and gateway with TLS.
THOGAMURA_ACCESS_ENABLED=false
THOGAMURA_ACCESS_SIGNING_KEY=
# Gateway only. Quote the semicolon-separated output of scripts/workspace-account.py.
THOGAMURA_ACCESS_USERS=''
# Assignable warehouse account names, comma-separated. Empty enables self-assignment.
THOGAMURA_FOLLOWUP_OWNERS=
# Enable for the browser-facing HTTPS host. Use false for loopback HTTP demonstrations.
THOGAMURA_ACCESS_SECURE_COOKIES=false
